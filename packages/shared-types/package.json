{
  "name": "@brokerdesk/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free types, enums and pure business rules shared by the BrokerDesk web app and API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
