# ─────────────────────────────────────────────────────────────────────────────
# BrokerDesk – environment template
# Copy (don't rename) to `.env` in the repo root and adjust. NEVER commit `.env`.
# Real environment variables always override values in this file.
# Nothing in here is ever bundled into the Angular app.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Port the NestJS API listens on.
PORT=3000

# ── MySQL (used by docker-compose.yml) ───────────────────────────────────────
MYSQL_DATABASE=brokerdesk
MYSQL_USER=brokerdesk
# Change both passwords. Use long random values outside local development.
MYSQL_PASSWORD=change-me-local-dev-password
MYSQL_ROOT_PASSWORD=change-me-local-root-password
# Host port MySQL is published on by docker compose.
MYSQL_HOST_PORT=3306

# ── Database (API + Prisma CLI) ──────────────────────────────────────────────
# Inside docker compose the API container overrides the host with `mysql`.
# allowPublicKeyRetrieval is required for MySQL 8.4's caching_sha2_password over
# non-TLS local connections. In production use TLS (ssl=true) instead.
# 127.0.0.1 (not localhost) avoids Node trying IPv6 ::1 first on Windows.
DATABASE_URL=mysql://brokerdesk:change-me-local-dev-password@127.0.0.1:3306/brokerdesk?allowPublicKeyRetrieval=true
# Disposable database used by `prisma migrate dev`.
SHADOW_DATABASE_URL=mysql://brokerdesk:change-me-local-dev-password@127.0.0.1:3306/brokerdesk_shadow?allowPublicKeyRetrieval=true
# Disposable database for API integration tests. Tests TRUNCATE it, so the
# database name must end in _test. Leave unset to skip database tests.
TEST_DATABASE_URL=mysql://brokerdesk:change-me-local-dev-password@127.0.0.1:3306/brokerdesk_test?allowPublicKeyRetrieval=true

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Extra browser origins allowed by CORS (comma-separated). In local dev the
# Angular dev server proxies /api to the API, so this can stay empty.
CORS_ORIGINS=
# Expose Swagger UI at /api/docs (defaults to false in production).
SWAGGER_ENABLED=true
# Number of reverse proxies in front of the API (nginx = 1). 0 in local dev.
TRUST_PROXY_HOPS=0

# ── Authentication ───────────────────────────────────────────────────────────
# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-secret-value-here
# Access-token lifetime (seconds) and refresh-token lifetime (days).
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Secure (HTTPS-only) refresh cookie. Defaults to true in production;
# local http://localhost development needs false.
REFRESH_COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7
# Rate limit for /auth/* and /invitations/* per client IP.
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# ── Public enquiry form (/enquire/<link>) ────────────────────────────────────
# Submissions per client IP per window, and new leads per agency per IST day.
PUBLIC_ENQUIRY_THROTTLE_LIMIT=5
PUBLIC_ENQUIRY_THROTTLE_TTL_SECONDS=600
PUBLIC_ENQUIRY_DAILY_CAP=200

# ── Property photos ──────────────────────────────────────────────────────────
# Folder for uploaded files (relative to apps/api). Back it up in production.
STORAGE_LOCAL_DIR=storage
# Lifetime of signed image URLs (seconds).
MEDIA_URL_TTL_SECONDS=3600

# ── Links & email ────────────────────────────────────────────────────────────
# Public URL of the web app (used in password-reset and invitation links).
APP_BASE_URL=http://localhost:4200
# log  = print emails (with their links) to the API console – development only
# none = drop emails (production default until an email provider is added)
MAIL_DRIVER=log

# ── Subscriptions (no payment gateway) ──
# Optional per-plan overrides of the default plan catalogue (prices in paise, null = unlimited), e.g.
# PLAN_CATALOG_JSON={"STARTER":{"monthlyPricePaise":59900,"leadLimit":300}}
PLAN_CATALOG_JSON=
# Shown to customers on the Plan page and receives in-app upgrade requests (optional)
SALES_CONTACT_EMAIL=

# ── Production only (deploy/docker-compose.prod.yml) ──
# Domain Caddy obtains the HTTPS certificate for, e.g. app.example.in
# BROKERDESK_DOMAIN=
