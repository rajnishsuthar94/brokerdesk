// BrokerDesk – Prisma schema (MySQL 8.4 LTS)
//
// Conventions
// - Primary keys: UUIDv7 strings stored as CHAR(36). v7 is time-ordered, which keeps
//   InnoDB clustered-index inserts append-only (better than random v4).
// - Tables and columns use snake_case in MySQL via @@map / @map; camelCase in code.
// - All timestamps are DATETIME(3) stored in UTC. The UI renders them in Asia/Kolkata.
// - Money: DECIMAL(14,2) (INR, up to ₹999,999,999,999.99). Never floats.
// - Every tenant-owned row carries `agency_id`.
// - Child rows of tenant data (activities, follow-ups, visits, images) reference
//   their parent through a COMPOSITE foreign key (agency_id, parent_id) →
//   parent(agency_id, id). The database itself therefore refuses a row whose
//   parent belongs to a different agency. See docs/database.md.
// - Business records use ON DELETE RESTRICT. Leads and properties are soft-deleted
//   (`deleted_at`) by the application. Only security tokens cascade with their user.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums (keep in sync with packages/shared-types/src/enums.ts)
// ─────────────────────────────────────────────────────────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadSource {
  WALK_IN
  PHONE
  WHATSAPP
  REFERRAL
  WEBSITE
  PROPERTY_PORTAL
  SOCIAL_MEDIA
  NEWSPAPER
  ENQUIRY_FORM
  OTHER
}

enum LeadActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  STATUS_CHANGE
  ASSIGNMENT
  FOLLOW_UP
  SITE_VISIT
  SYSTEM
}

enum PropertyType {
  APARTMENT
  BUNGALOW
  ROW_HOUSE
  TENEMENT
  PENTHOUSE
  PLOT
  SHOP
  OFFICE
  OTHER
}

enum ListingType {
  SALE
  RENT
}

enum AreaUnit {
  SQFT
  SQYD
  SQM
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum AvailabilityStatus {
  AVAILABLE
  ON_HOLD
  SOLD
  RENTED
  ARCHIVED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SiteVisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────────────────────

model Agency {
  id                 String   @id @default(uuid(7)) @db.Char(36)
  name               String   @db.VarChar(150)
  email              String?  @db.VarChar(191)
  phone              String?  @db.VarChar(20)
  address            String?  @db.VarChar(500)
  city               String?  @db.VarChar(100)
  state              String?  @db.VarChar(100)
  country            String   @default("IN") @db.Char(2)
  timezone           String   @default("Asia/Kolkata") @db.VarChar(64)
  /// Public, unguessable id of the agency's online enquiry form (/enquire/<slug>).
  /// Can be regenerated by owners/admins, which disables the old link.
  publicSlug         String   @unique @map("public_slug") @db.VarChar(80)
  enquiryFormEnabled Boolean  @default(true) @map("enquiry_form_enabled")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  members          AgencyMember[]
  invitations      AgencyInvitation[]
  leads            Lead[]
  leadActivities   LeadActivity[]
  properties       Property[]
  propertyImages   PropertyImage[]
  followUps        FollowUp[]
  siteVisits       SiteVisit[]
  messageTemplates MessageTemplate[]
  subscription     Subscription?
  auditLogs        AuditLog[]

  @@map("agencies")
}

model User {
  id           String    @id @default(uuid(7)) @db.Char(36)
  name         String    @db.VarChar(150)
  /// Stored lower-cased and trimmed by the application.
  email        String    @unique @db.VarChar(191)
  /// E.164 format, e.g. +919876543210.
  phone        String?   @db.VarChar(20)
  /// Argon2id encoded hash (includes algorithm parameters and salt).
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships         AgencyMember[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     AgencyInvitation[]   @relation("InvitedBy")
  assignedLeads       Lead[]               @relation("LeadAssignee")
  assignedProperties  Property[]           @relation("PropertyAssignee")
  assignedFollowUps   FollowUp[]           @relation("FollowUpAssignee")
  assignedSiteVisits  SiteVisit[]          @relation("SiteVisitAssignee")
  leadActivities      LeadActivity[]
  auditLogs           AuditLog[]

  @@map("users")
}

model AgencyMember {
  id       String     @id @default(uuid(7)) @db.Char(36)
  agencyId String     @map("agency_id") @db.Char(36)
  userId   String     @map("user_id") @db.Char(36)
  role     MemberRole @default(AGENT)
  joinedAt DateTime   @default(now()) @map("joined_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([agencyId, userId])
  @@index([userId])
  @@map("agency_members")
}

/// Pending invitation for a person to join an agency. Only a hash of the token is stored.
model AgencyInvitation {
  id          String     @id @default(uuid(7)) @db.Char(36)
  agencyId    String     @map("agency_id") @db.Char(36)
  email       String     @db.VarChar(191)
  role        MemberRole @default(AGENT)
  tokenHash   String     @unique @map("token_hash") @db.Char(64)
  invitedById String     @map("invited_by_id") @db.Char(36)
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  revokedAt   DateTime?  @map("revoked_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([agencyId, email])
  @@map("agency_invitations")
}

/// Rotating refresh tokens. Only a SHA-256 hash is stored. Tokens issued from the same
/// login share a `familyId`; re-use of a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  familyId     String    @map("family_id") @db.Char(36)
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Char(36)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id                String        @id @default(uuid(7)) @db.Char(36)
  agencyId          String        @map("agency_id") @db.Char(36)
  /// Must be a member of the same agency — enforced in the service layer.
  assignedUserId    String?       @map("assigned_user_id") @db.Char(36)
  name              String        @db.VarChar(150)
  /// E.164 format, e.g. +919876543210.
  phone             String        @db.VarChar(20)
  email             String?       @db.VarChar(191)
  source            LeadSource    @default(OTHER)
  budgetMin         Decimal?      @map("budget_min") @db.Decimal(14, 2)
  budgetMax         Decimal?      @map("budget_max") @db.Decimal(14, 2)
  preferredLocation String?       @map("preferred_location") @db.VarChar(191)
  bhk               Int?          @db.UnsignedTinyInt
  propertyType      PropertyType? @map("property_type")
  listingType       ListingType   @default(SALE) @map("listing_type")
  /// Optional area requirement used by matching (schema addition).
  areaMin           Decimal?      @map("area_min") @db.Decimal(12, 2)
  areaMax           Decimal?      @map("area_max") @db.Decimal(12, 2)
  areaUnit          AreaUnit?     @map("area_unit")
  status            LeadStatus    @default(NEW)
  priority          LeadPriority  @default(MEDIUM)
  nextFollowUpAt    DateTime?     @map("next_follow_up_at")
  /// When the lead was marked WON or LOST (cleared if reopened). Used for conversion charts.
  closedAt          DateTime?     @map("closed_at")
  notes             String?       @db.Text
  /// Soft delete marker (schema addition). Deleted leads are hidden but keep history.
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  agency       Agency         @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  assignedUser User?          @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]
  followUps    FollowUp[]
  siteVisits   SiteVisit[]

  /// Target of composite FKs from child tables (tenant-safe references).
  @@unique([agencyId, id])
  @@index([agencyId, deletedAt, status])
  @@index([agencyId, deletedAt, createdAt])
  @@index([agencyId, assignedUserId])
  @@index([agencyId, nextFollowUpAt])
  @@index([agencyId, status, closedAt])
  @@index([agencyId, phone])
  @@index([assignedUserId])
  @@map("leads")
}

model LeadActivity {
  id           String           @id @default(uuid(7)) @db.Char(36)
  agencyId     String           @map("agency_id") @db.Char(36)
  leadId       String           @map("lead_id") @db.Char(36)
  /// Author of the activity; null for system-generated entries.
  userId       String?          @map("user_id") @db.Char(36)
  activityType LeadActivityType @map("activity_type")
  description  String           @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  lead   Lead   @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId, leadId, createdAt])
  @@index([userId])
  @@map("lead_activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Property inventory
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id                 String             @id @default(uuid(7)) @db.Char(36)
  agencyId           String             @map("agency_id") @db.Char(36)
  assignedUserId     String?            @map("assigned_user_id") @db.Char(36)
  title              String             @db.VarChar(200)
  propertyType       PropertyType       @map("property_type")
  listingType        ListingType        @map("listing_type")
  projectName        String?            @map("project_name") @db.VarChar(191)
  location           String             @db.VarChar(191)
  city               String             @default("Ahmedabad") @db.VarChar(100)
  /// Sale price, or monthly rent when listingType = RENT.
  price              Decimal            @db.Decimal(14, 2)
  bhk                Int?               @db.UnsignedTinyInt
  area               Decimal?           @db.Decimal(12, 2)
  areaUnit           AreaUnit           @default(SQFT) @map("area_unit")
  furnishing         Furnishing?
  /// Free text to allow values like "G", "3 of 12", "Penthouse".
  floor              String?            @db.VarChar(30)
  /// Number of parking spots.
  parking            Int                @default(0) @db.UnsignedTinyInt
  description        String?            @db.Text
  ownerName          String?            @map("owner_name") @db.VarChar(150)
  ownerPhone         String?            @map("owner_phone") @db.VarChar(20)
  availabilityStatus AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  deletedAt          DateTime?          @map("deleted_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  agency       Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  assignedUser User?           @relation("PropertyAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  images       PropertyImage[]
  siteVisits   SiteVisit[]

  @@unique([agencyId, id])
  @@index([agencyId, deletedAt, availabilityStatus])
  @@index([agencyId, listingType, propertyType, price])
  @@index([agencyId, city, location])
  @@index([agencyId, bhk])
  @@index([assignedUserId])
  @@map("properties")
}

/// Image metadata only. Binary files live in object/local storage under `storageKey`.
model PropertyImage {
  id               String   @id @default(uuid(7)) @db.Char(36)
  agencyId         String   @map("agency_id") @db.Char(36)
  propertyId       String   @map("property_id") @db.Char(36)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  originalFileName String   @map("original_file_name") @db.VarChar(255)
  /// Schema addition: needed to serve and validate uploads safely.
  mimeType         String   @map("mime_type") @db.VarChar(100)
  sizeBytes        Int      @map("size_bytes") @db.UnsignedInt
  displayOrder     Int      @default(0) @map("display_order") @db.UnsignedSmallInt
  createdAt        DateTime @default(now()) @map("created_at")

  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [agencyId, propertyId], references: [agencyId, id], onDelete: Restrict)

  @@index([agencyId, propertyId, displayOrder])
  @@map("property_images")
}

// ─────────────────────────────────────────────────────────────────────────────
// Follow-ups & site visits
// ─────────────────────────────────────────────────────────────────────────────

model FollowUp {
  id             String         @id @default(uuid(7)) @db.Char(36)
  agencyId       String         @map("agency_id") @db.Char(36)
  leadId         String         @map("lead_id") @db.Char(36)
  assignedUserId String?        @map("assigned_user_id") @db.Char(36)
  dueAt          DateTime       @map("due_at")
  status         FollowUpStatus @default(PENDING)
  notes          String?        @db.Text
  completedAt    DateTime?      @map("completed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  agency       Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  lead         Lead   @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Restrict)
  assignedUser User?  @relation("FollowUpAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([agencyId, status, dueAt])
  @@index([agencyId, assignedUserId, status, dueAt])
  @@index([agencyId, leadId, dueAt])
  @@index([assignedUserId])
  @@map("follow_ups")
}

model SiteVisit {
  id             String          @id @default(uuid(7)) @db.Char(36)
  agencyId       String          @map("agency_id") @db.Char(36)
  leadId         String          @map("lead_id") @db.Char(36)
  propertyId     String          @map("property_id") @db.Char(36)
  assignedUserId String?         @map("assigned_user_id") @db.Char(36)
  scheduledAt    DateTime        @map("scheduled_at")
  status         SiteVisitStatus @default(SCHEDULED)
  feedback       String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  lead         Lead     @relation(fields: [agencyId, leadId], references: [agencyId, id], onDelete: Restrict)
  property     Property @relation(fields: [agencyId, propertyId], references: [agencyId, id], onDelete: Restrict)
  assignedUser User?    @relation("SiteVisitAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([agencyId, status, scheduledAt])
  @@index([agencyId, leadId])
  @@index([agencyId, propertyId])
  @@index([assignedUserId])
  @@map("site_visits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging, subscriptions, audit
// ─────────────────────────────────────────────────────────────────────────────

model MessageTemplate {
  id        String   @id @default(uuid(7)) @db.Char(36)
  agencyId  String   @map("agency_id") @db.Char(36)
  title     String   @db.VarChar(150)
  message   String   @db.Text
  category  String   @default("GENERAL") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@unique([agencyId, title])
  @@index([agencyId, category])
  @@map("message_templates")
}

/// One current subscription per agency. Limits are snapshotted from the configurable
/// plan catalogue when the plan changes; NULL limit = unlimited.
model Subscription {
  id        String             @id @default(uuid(7)) @db.Char(36)
  agencyId  String             @unique @map("agency_id") @db.Char(36)
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  leadLimit Int?               @map("lead_limit") @db.UnsignedInt
  userLimit Int?               @map("user_limit") @db.UnsignedSmallInt
  startsAt  DateTime           @default(now()) @map("starts_at")
  expiresAt DateTime?          @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}

/// Append-only audit trail of security-relevant and business-critical actions.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Char(36)
  /// Null for actions outside any agency (e.g. login, registration).
  agencyId    String?  @map("agency_id") @db.Char(36)
  actorUserId String?  @map("actor_user_id") @db.Char(36)
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Char(36)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  agency    Agency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  actorUser User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([agencyId, entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}
